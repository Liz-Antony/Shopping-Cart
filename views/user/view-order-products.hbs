<section>
    <div class="container mt-5 p-3">
        <div class="row">
            {{#each products}}
                <div class="col-md-3 p-1">
                    <div class="card" style="width: 15rem;">
                        <img class="card-img-top" src="/product-images/{{this.product._id}}.jpg" alt="{{this.name}}" style="width: 100%; height: 10rem; object-fit: cover;">
                        <div class="card-body">
                            <h5 class="card-title">{{this.product.name}}</h5>
                            <h6>{{this.product.price}}</h6>
                            <p class="card-text">{{this.product.description}}</p>
                            
                        </div>
                    </div>
                </div>
            {{/each}}
        </div>
    </div>
</section>